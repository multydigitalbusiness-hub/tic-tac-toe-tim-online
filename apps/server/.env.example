PORT=3001
NODE_ENV=development
REDIS_URL=redis://localhost:6379
# CORS_ORIGIN aceita uma lista separada por vírgula. Suporta curinga `*` em um
# único rótulo de subdomínio (ex.: previews da Vercel):
#   https://app.vercel.app,https://app-*.vercel.app
CORS_ORIGIN=http://localhost:5173
# Em produção, o segredo default abaixo é REJEITADO no boot. Gere um forte com:
#   openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-in-production-please
LOG_LEVEL=info
